# Конфигурация автономного контура доставки (`loop/`).
#
# Скопируйте в `loop/.env` и заполните. Три переменные обязательны — без них процесс не стартует и
# печатает в stderr имя недостающей. Остальные проверяются, только если заданы: ненастроенная
# интеграция — это выключенная возможность, а не отказ загрузки.

# --- обязательные ---

# Учётные данные исполнителя — РОВНО ОДНО из двух. Передаётся точечно в контейнер исполнителя;
# сам файл `.env` внутрь не попадает.
#
#   ANTHROPIC_API_KEY        — ключ Anthropic Console, оплата по токенам;
#   CLAUDE_CODE_OAUTH_TOKEN  — долгоживущий токен подписки (`claude setup-token`), оплата тарифом.
#
# Обе сразу — отказ загрузки, и это защита: CLI предпочитает ключ токену, так что контур, который
# вы считали работающим на подписке, молча тратил бы ключ.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Порт локального дашборда. Контур слушает только 127.0.0.1.
PORT=3100

# Корневая рабочая директория проектов, которые собирает контур. Безопасного значения по
# умолчанию нет: угадать её значило бы писать чужой код в угаданный каталог.
WORKSPACE_ROOT_PATH=

# --- необязательные ---

# Где контур держит свою SQLite. По умолчанию `.data/loop.db` внутри пакета (в .gitignore).
LOOP_DB_PATH=

# Переопределение шва Docker Engine. Пусто — транспорт выбирается по платформе:
# именованный канал на Windows, unix-сокет на Linux/CI.
DOCKER_ENGINE_PIPE=
DOCKER_ENGINE_SOCKET=

# Локально запущенная Spec Platform — для фасада M17а.
SPEC_PLATFORM_API_BASE=

# Цепочка провайдеров в порядке попыток — конфигурация, не код: контур просит у модели ТЕКСТЫ
# handoff-заданий, и кто отвечает, решает эта строка. Названный, но без ключа, просто пропускается.
# Значения: anthropic, openai, google, ollama, claude-cli. По умолчанию — anthropic.
#
# На подписочной машине (CLAUDE_CODE_OAUTH_TOKEN, без ANTHROPIC_API_KEY) роли архитектора заданий
# нужна ПАРА: эта строка ДОЛЖНА вести с моста и ниже ДОЛЖЕН быть задан CLAUDE_CLI_API_BASE —
#   LOOP_PROVIDER_ORDER=claude-cli,google
#   CLAUDE_CLI_API_BASE=http://127.0.0.1:8091/v1
# Без пары звено anthropic пропускается (SDK-адаптер требует ключ, не токен), и задания молча
# пишет фолбэк/запасной провайдер — финальная приёмка Программы А получила 36/41 заданий без
# тестовых команд ровно из-за отсутствия этой пары (перезаход №2 fix-раунда, А-33 п.4в).
LOOP_PROVIDER_ORDER=
LOOP_ANTHROPIC_MODEL=
OPENAI_API_KEY=
LOOP_OPENAI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
LOOP_GOOGLE_MODEL=
LOOP_LLM_TIMEOUT_MS=

# Предел одного прогона тестов приёмки, миллисекунды (умолчание 300000 — 5 минут). Тест, который
# не завершился за это время, — красный вердикт «тесты не завершились»; пятнадцатиминутный потолок
# приёмки остаётся задним упором всего прогона (задача 174).
ACCEPTANCE_TEST_TIMEOUT_MS=

# Локальный LLM-провайдер (Ollama, OpenAI-совместимый) и модель — звено `ollama` цепочки.
LOCAL_LLM_API_BASE=
LOCAL_LLM_MODEL=

# Мост подписки — звено `claude-cli` цепочки (задача 175): локальный OpenAI-совместимый сервер
# поверх Claude Code CLI. Поднимается командой пакета `pnpm bridge` (читает CLAUDE_CODE_OAUTH_TOKEN
# из этого же файла; BRIDGE_PORT — порт, по умолчанию 8091; CLAUDE_CLI_PATH — путь к CLI, если он
# не в ~/.local/bin и не в PATH). Платформа подключает тот же мост своим локальным звеном:
# OLLAMA_BASE_URL=http://127.0.0.1:8091/v1 — и обязательно OLLAMA_CONTEXT_LENGTH=200000 плюс
# LLM_REQUEST_TIMEOUT_MS=600000: без первого платформа пакует под олламские 4096, без второго
# роняет звено на генерациях длиннее минуты (гейт-профиль платформы всегда нёс оба).
CLAUDE_CLI_API_BASE=
BRIDGE_PORT=
CLAUDE_CLI_PATH=

# Локальный Whisper-совместимый API — для голосового ввода M17а.
WHISPER_API_BASE=

# Телеграм-бот и чат владельца — M17а. Шлюз включается ПАРОЙ переменных; без неё контур работает
# как раньше, а консоль называет недостающую. SPEC_PLATFORM_API_BASE (выше) включает фасад
# «задумка → платформа → бандл → контур».
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# База Bot API — только для гейтовых прогулок (локальный стенд); боевое умолчание api.telegram.org.
TELEGRAM_API_BASE=

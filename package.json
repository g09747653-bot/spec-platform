{
  "name": "spec-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:gate": "node scripts/dev-gate.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "test:unit": "vitest run --coverage",
    "loop:typecheck": "pnpm --filter @spec-platform/loop typecheck",
    "loop:test": "pnpm --filter @spec-platform/loop test:unit",
    "loop:migrate": "pnpm --filter @spec-platform/loop db:migrate",
    "test:preflight": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "db:test-server": "node scripts/test-db-server.mjs",
    "db:local-server": "node scripts/local-db-server.mjs",
    "local:up": "node scripts/local-stack.mjs up",
    "local:down": "node scripts/local-stack.mjs down",
    "db:generate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:generate:custom": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs generate --custom"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.38",
    "@ai-sdk/google": "4.0.43",
    "@ai-sdk/openai": "4.0.41",
    "@auth/drizzle-adapter": "1.11.3",
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.8.0",
    "ai": "7.0.64",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "mammoth": "1.12.1",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "unpdf": "1.8.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-socket": "0.2.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "^8.20.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "sharp"
    ]
  }
}

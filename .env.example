# Template for local configuration. Copy to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed (constitution S3).
#
# The authoritative variable list is the Configuration table in `.specs/solution.md`.
# Variables are validated by `src/config/env.ts` at boot; the process refuses to start on an
# invalid configuration. Optional variables become required at the milestone that uses them.

# --- Required now (Milestone 0) ---
# Neon connection string for the branch this environment targets.
DATABASE_URL=

# Neon preview branch. Used by preview deployments (task 9), not by the app at runtime.
DATABASE_URL_PREVIEW=

# --- Required from Milestone 1 — Auth.js (tasks 12, 14) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional, and deliberately so (D-21): Auth.js derives the callback base from the request, so one
# build serves the production domain and every preview URL. Set it locally, never on a deployment.
AUTH_URL=http://localhost:3000

# --- Milestone 3 — LLM providers (tasks 42–43) ---
#
# A key is required for every provider named in LLM_PROVIDER_ORDER, and optional for the others
# (D-46). Adding a provider later is therefore a configuration change: extend the chain and supply
# that provider's key — no code change anywhere (IR-001-AC-4).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Ordered failover chain. Default: google
LLM_PROVIDER_ORDER=

# --- Local provider — development and the milestone gate only (round 3, D-90) ---
#
# `ollama` is a fourth adapter, not a fourth mandated integration: the three the constitution names
# are unchanged. It exists so a spent daily quota stops the walk from stopping. It needs no key —
# only an address — and its availability is deliberately not checked at boot: a local model that is
# not running is an ordinary provider failure, and the chain already survives those.
#
# Unreachable from a deployment by construction (localhost is not somewhere Vercel can dial), so
# production keeps the chain it has. Requires `ollama serve` and the model in DEFAULT_MODELS.ollama.
# Default: http://localhost:11434/v1
OLLAMA_BASE_URL=
#
# The window `ollama serve` was started with (А-8, task 130). Prompts are packed to it minus a
# generation reserve, because a local runtime handed more than it can read does not refuse — it
# drops the head of the prompt, instruction and all, and answers from the tail (D-146). Ollama's
# own variable name, deliberately: the server and the assembler must read one number, not two.
# Default: 4096 (Ollama's own default). The gate runs at 16384 — see scripts/dev-gate.mjs.
OLLAMA_CONTEXT_LENGTH=
# Default: 60000
LLM_REQUEST_TIMEOUT_MS=

# --- Workflow tuning (defaults shown; all optional) ---
# Registers the optional Quality capability. Default: false (constitution P3).
QUALITY_STAGE_ENABLED=
# Question-round budget per stage. Default: 3 (FR-005 AC-10).
MAX_ROUNDS_PER_STAGE=
# Below this confidence a chat-typed decision abstains. Default: 0.8 (D-4).
DECISION_INTENT_MIN_CONFIDENCE=

# --- Milestone 5 — uploads, parsing and research (tasks 63–68) ---
# Both are REQUIRED: the process refuses to boot without them, so a deployment cannot silently
# serve an in-process store or a search that finds nothing (D-73).
# Set either to the literal `none` to run without that account — the in-process store and the null
# research adapter. That is what the end-to-end suite does; a deployment should not.
# The Blob token appears automatically once a Blob store is connected to the Vercel project.
BLOB_READ_WRITE_TOKEN=none
WEB_SEARCH_API_KEY=none
# Default: 1000000
WEB_FETCH_MAX_BYTES=
# Default: 10000
WEB_FETCH_TIMEOUT_MS=
# Default: 30000
PARSE_TIMEOUT_MS=
# Default: 10485760 (10 MiB)
MAX_UPLOAD_BYTES=
# Comma-separated MIME types. Default: pdf, docx, xlsx, text/plain, text/markdown, png, jpeg
ALLOWED_UPLOAD_TYPES=

# --- Milestone 8 — error monitoring (task 95) ---
SENTRY_DSN=

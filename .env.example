# Template for local configuration. Copy to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed (constitution S3).
#
# The authoritative variable list is the Configuration table in `.specs/solution.md`.
# Variables are validated by `src/config/env.ts` at boot; the process refuses to start on an
# invalid configuration. Optional variables become required at the milestone that uses them.

# --- Required now (Milestone 0) ---
# Neon connection string for the branch this environment targets.
DATABASE_URL=

# Neon preview branch. Used by preview deployments (task 9), not by the app at runtime.
DATABASE_URL_PREVIEW=

# --- Milestone 1 — Auth.js (tasks 12, 14) ---
AUTH_SECRET=
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Milestone 3 — LLM providers (tasks 39–44) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Ordered failover chain. Default: anthropic,openai,google
LLM_PROVIDER_ORDER=
# Default: 60000
LLM_REQUEST_TIMEOUT_MS=

# --- Workflow tuning (defaults shown; all optional) ---
# Registers the optional Quality capability. Default: false (constitution P3).
QUALITY_STAGE_ENABLED=
# Question-round budget per stage. Default: 3 (FR-005 AC-10).
MAX_ROUNDS_PER_STAGE=
# Below this confidence a chat-typed decision abstains. Default: 0.8 (D-4).
DECISION_INTENT_MIN_CONFIDENCE=

# --- Milestone 5 — uploads, parsing and research (tasks 63–68) ---
BLOB_READ_WRITE_TOKEN=
WEB_SEARCH_API_KEY=
# Default: 1000000
WEB_FETCH_MAX_BYTES=
# Default: 10000
WEB_FETCH_TIMEOUT_MS=
# Default: 30000
PARSE_TIMEOUT_MS=
# Default: 10485760 (10 MiB)
MAX_UPLOAD_BYTES=
# Comma-separated MIME types. Default: pdf, docx, xlsx, text/plain, text/markdown, png, jpeg
ALLOWED_UPLOAD_TYPES=

# --- Milestone 8 — error monitoring (task 95) ---
SENTRY_DSN=

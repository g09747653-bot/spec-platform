{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    /*
     * A relative import may carry its `.ts` extension — the same permission `loop/tsconfig.json`
     * grants, for the same reason (task 173). The hand-run walks under `e2e/` are executed by bare
     * `node`, which strips types but does no extension resolution, so the one module they now share
     * has to be named with its extension. Everything the bundler compiles keeps the extensionless
     * house style; this option permits, it does not require.
     */
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/modules/**/__fixtures__/**",
    ".next",
    "coverage",
    "loop"
  ]
}
